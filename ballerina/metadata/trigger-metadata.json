{
  "version": "v1.0",
  "listeners": [
    {
      "id": "$listener",
      "doc": "Consumes messages delivered from a subscribed JMS queue or topic and dispatches each to the attached service.",
      "type": { "name": "Listener" },
      "services": ["$service"],
      "multipleServicesAllowed": false
    }
  ],
  "serviceTypes": [
    {
      "id": "$service",
      "doc": "Consumes messages delivered from a subscribed JMS queue or topic.",
      "type": { "name": "Service" },
      "concrete": false,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "id": "$service.onMessage",
            "name": "onMessage",
            "kind": "remote",
            "doc": "Invoked once per message delivered from the subscribed queue or topic.",
            "presence": "required",
            "params": [
              {
                "id": "$service.onMessage.message",
                "name": "message",
                "doc": "The delivered JMS message.",
                "type": { "name": "Message" },
                "presence": "required"
              },
              {
                "id": "$service.onMessage.caller",
                "name": "caller",
                "doc": "Handle for explicitly acknowledging or committing/rolling back the message.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onMessage.returns",
              "type": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }]
            }
          }
        ]
      }
    }
  ]
}
